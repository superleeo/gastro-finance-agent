# ============================================================
# Gastro Finance Agent — 环境变量配置
# ============================================================
# 复制此文件为 .env，修改为你的餐厅信息。
#   cp .env.example .env
# ============================================================

# 餐厅名称（显示在 Dashboard 侧边栏和邮件签名中）
GASTRO_RESTAURANT_NAME="Mein Restaurant"

# 财务部门联系邮箱
GASTRO_RESTAURANT_EMAIL="buchhaltung@mein-restaurant.de"

# 联系电话（显示在邮件签名中）
GASTRO_RESTAURANT_PHONE="+49 (0)30 1234567"

# 餐厅地址（可选）
GASTRO_RESTAURANT_ADDRESS="Musterstraße 1, 10115 Berlin"

# 演示模式 (1=启用测试数据, 0=生产模式)
GASTRO_DEMO_MODE=0
